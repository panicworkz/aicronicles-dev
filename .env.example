# ==========================================
# PANIC CMS ENVIRONMENT CONFIGURATION
# ==========================================

NODE_ENV=production

# Database Configuration
POSTGRES_USER=panic
POSTGRES_PASSWORD=panic_pass
POSTGRES_DB=panic_cms
DATABASE_URL=postgresql://panic:panic_pass@panic-postgres:5432/panic_cms

# Authentication & Security
# The rotated JWT_SECRET already set on server:
JWT_SECRET=your_existing_rotated_jwt_secret_from_docker_compose

# Media Configuration (mounted on host at /opt/panic/media)
MEDIA_DIR=/opt/panic/media

# Site Settings
NEXT_PUBLIC_SITE_URL=https://fabelo.testworkz.com
NEXT_PUBLIC_SITE_DOMAIN=fabelo.testworkz.com

# Havale hesabi — siparis onayinda musteriye bu bilgiler gidiyor.
# Tanimli degilse hesap bilgisi UYDURULMUYOR; musteriye "detaylari
# yollayacagiz" deniyor (bkz. lib/siparis-eposta.ts).
BANKA_UNVAN=
BANKA_ADI=
BANKA_IBAN=
# SWIFT/BIC yurt disindan gonderen bankalar icin gerekli. IBAN tek
# basina yalnizca SEPA alaninda yetiyor; bos birakilirsa uluslararasi
# havale ya reddedilir ya elle isleme duser.
BANKA_SWIFT=

# SAYFA OLCUMU — Umami (kendi sunucumuzda, cerezsiz).

# GONDERME: tarayiciya takilan betigin site kimligi. Bos birakilirsa
# hicbir sey yuklenmiyor — stage'de bos, cunku sinama gezintileri
# sitenin ziyaretci sayisina karismamali.
UMAMI_TRACK_ID=

# OKUMA: rapor ekrani icin. HESAP GEREKMIYOR — Umami'nin paylasim
# (share) kodu salt okunur erisim veriyor ve site kimligi de o
# paylasimdan geliyor. Umami arayuzunde siteyi paylasima acinca
# cikan adresteki kisa kod.
UMAMI_URL=https://umami.panic.pw
UMAMI_SHARE_SLUG=
