# ==========================================
# PANIC CMS ENVIRONMENT CONFIGURATION
# ==========================================

NODE_ENV=production

# Database Configuration
POSTGRES_USER=panic
POSTGRES_PASSWORD=panic_pass
POSTGRES_DB=panic_cms
DATABASE_URL=postgresql://panic:panic_pass@panic-postgres:5432/panic_cms

# Authentication & Security
# The rotated JWT_SECRET already set on server:
JWT_SECRET=your_existing_rotated_jwt_secret_from_docker_compose

# Media Configuration (mounted on host at /opt/panic/media)
MEDIA_DIR=/opt/panic/media

# Site Settings
NEXT_PUBLIC_SITE_URL=https://fabelo.testworkz.com
NEXT_PUBLIC_SITE_DOMAIN=fabelo.testworkz.com
