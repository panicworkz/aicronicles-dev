# ==========================================
# PANIC CMS ENVIRONMENT CONFIGURATION
# ==========================================

NODE_ENV=production

# Database Configuration
POSTGRES_USER=panic
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=panic_cms
DATABASE_URL=postgresql://panic:your_strong_postgres_password_here@panic-postgres:5432/panic_cms

# Authentication & Security
# Generate with: openssl rand -base64 48
JWT_SECRET=your_super_strong_random_jwt_secret_key_here

# Site Settings
NEXT_PUBLIC_SITE_URL=https://fabelo.testworkz.com
NEXT_PUBLIC_SITE_DOMAIN=fabelo.testworkz.com
